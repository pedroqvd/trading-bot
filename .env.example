# =============================================================================
# Polymarket trading bot configuration
# Copy to `.env` and fill in. Do not commit the real file.
# =============================================================================

# --- Environment ---------------------------------------------------------------
APP_ENV=production               # production | staging | backtest
LOG_LEVEL=INFO
TIMEZONE=UTC

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://trader:trader@db:5432/trading

# --- Polymarket ---------------------------------------------------------------
# Public endpoints
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137                # Polygon mainnet

# Authentication — required for live trading. Leave blank for dry-run / backtest.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=             # Proxy wallet that holds USDC (optional)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Trading --------------------------------------------------------------------
CAPITAL_USD=1000                      # Total trading capital
DRY_RUN=true                          # true = no live orders; false = live trading
POLL_INTERVAL_SECONDS=30              # Market scan cadence
MAX_OPEN_POSITIONS=20

# --- Edge thresholds ------------------------------------------------------------
MIN_MISPRICING=0.03                   # 3 cents minimum edge
MIN_EXPECTED_VALUE=0.015              # 1.5% EV floor
MIN_LIQUIDITY_USD=500                 # Minimum book depth
MAX_SPREAD=0.04                       # 4 cents max spread

# Overreaction edge
OVERREACTION_MOVE_PCT=0.10            # >10% move triggers candidate
OVERREACTION_WINDOW_MINUTES=15
OVERREACTION_MIN_VOLUME_USD=5000
OVERREACTION_REVERSION_TARGET=0.5     # fraction of move to reverse
OVERREACTION_TAKE_PROFIT=0.07
OVERREACTION_STOP_LOSS=0.05
OVERREACTION_MAX_HOLD_MINUTES=240

# Arbitrage edge
ARBITRAGE_MIN_EDGE=0.02               # |1 - (yes+no)| must exceed this
ARBITRAGE_MAX_LEG_SLIPPAGE=0.005

# --- Risk management ----------------------------------------------------------
KELLY_FRACTION=0.25                   # Fractional Kelly
MAX_POSITION_PCT=0.05                 # 5% of capital per trade
MAX_PORTFOLIO_EXPOSURE=0.6            # 60% of capital in open trades
MAX_DAILY_LOSS_PCT=0.05               # 5% daily drawdown circuit breaker
MAX_DRAWDOWN_PCT=0.15                 # 15% portfolio drawdown kill-switch

# --- Execution realism --------------------------------------------------------
SLIPPAGE_BPS=20                       # 20 bps assumed slippage
TAKER_FEE_BPS=0                       # Polymarket is currently fee-free; keep knob

# --- Monitoring ---------------------------------------------------------------
PROMETHEUS_PORT=9108
ALERT_WEBHOOK_URL=                    # Optional Slack/Discord webhook
